VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never prefix this with VITE_. It is for the future server-side Groq adapter only.
GROQ_API_KEY=

# Optional: set by the future Cloudflare Worker / API gateway.
VITE_API_BASE_URL=
