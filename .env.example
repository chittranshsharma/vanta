# Public Supabase values are safe to expose to the browser only when Row Level Security is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never prefix this with VITE_. It is for the future server-side Groq adapter only.
GROQ_API_KEY=

# Optional: set by the future Cloudflare Worker / API gateway.
VITE_API_BASE_URL=

# Client feature flags (build-time). Empty = everything off. Known: claim_grounding_panel,video_intake,jobs_panel,connectors_panel
VITE_FLAGS=
# Optional operator-owned endpoint for scrubbed client error events (Upgrade G). Empty = console only.
VITE_TELEMETRY_ENDPOINT=
VITE_APP_VERSION=

# Optional: QA-1 Real-JWT Two-User E2E Isolation Suite
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
